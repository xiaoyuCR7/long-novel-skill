{
  "name": "long-novel-skill",
  "version": "6.7.0",
  "description": "通用网文创作助手（长篇+短篇）：开书、百万字结构展开、三级大纲、7 Gate去AI腔、敏感词替换表（地名代称/别称置换/地名脱敏）、节奏三档制、知识图谱、RAG检索、质量评分、编辑团队协作。支持34题材、多平台适配。",
  "activation": {
    "patterns": [
      "/long-novel-skill",
      "/开书",
      "/写小说",
      "/网文"
    ],
    "triggers": [
      "用户想写小说",
      "用户想写网文",
      "用户提到开书",
      "用户提到写大纲",
      "用户提到写第X章",
      "用户提到续写",
      "用户提到日更",
      "用户提到卡文",
      "用户提到人设崩了",
      "用户提到伏笔",
      "用户提到爽点",
      "用户提到拆文",
      "用户提到扫榜",
      "用户提到仿写",
      "用户提到投稿平台",
      "用户提到去AI味",
      "用户提到脑洞",
      "用户提到扩充",
      "用户提到质量评分",
      "用户提到结尾句",
      "用户提到点睛句",
      "用户提到彩蛋",
      "用户提到碎碎念",
