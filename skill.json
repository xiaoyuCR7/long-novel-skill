      "用户提到敏感词",
      "用户提到脱敏",
      "用户提到地名代称",
      "用户提到别称置换"
    ]
  },
  "compatibility": {
    "requires": [
      "Python 3.8+",
      "文件系统读写权限"
    ],
    "supported_tools": [
      "claude-code",
      "trae",
      "cursor",
      "opencode",
      "codex",
      "gemini-cli",
      "antigravity",
      "mcp-client"
    ],
    "installer": {
      "bash": "install.sh",
      "powershell": "install.ps1"
    }
  },
  "mcp_server": {
    "enabled": true,
    "entry": "mcp_server/server.py",
    "transport": "stdio",
    "tools_count": 26
  },
