{
  "name": "long-novel-skill",
  "version": "8.2.0",
  "description": "面向中文长篇网文的可恢复创作系统：以轻量意图路由、章意图契约、场景渲染内核和原子追踪事务协调开书、续写、修订、分析与发布。支持34题材、多平台适配。",
  "activation": {
    "patterns": [
      "/long-novel-skill",
      "/开书",
      "/写小说",
      "/网文"
    ],
    "triggers": [
      "用户想写小说",
      "用户想写网文",
      "用户提到开书",
      "用户提到写大纲",
      "用户提到写第X章",
      "用户提到续写",
      "用户提到日更",
      "用户提到卡文",
      "用户提到人设崩了",
      "用户提到伏笔",
      "用户提到爽点",
      "用户提到拆文",
      "用户提到扫榜",
      "用户提到仿写",
      "用户提到投稿平台",
      "用户提到去AI味",
      "用户提到脑洞",
      "用户提到扩充",
      "用户提到质量评分",
      "用户提到结尾句",
      "用户提到点睛句",
      "用户提到彩蛋",
      "用户提到碎碎念",
      "用户提到字数检查",
      "用户提到敏感词",
      "用户提到脱敏",
      "用户提到地名代称",
      "用户提到别称置换",
      "用户提到章节衔接",
      "用户提到脱节",
      "用户提到连贯性",
      "用户提到章间"
    ]
  },
  "compatibility": {
    "requires": [
      "Python 3.8+",
      "文件系统读写权限"
    ],
    "supported_tools": [
      "claude-code",
      "trae",
      "cursor",
      "opencode",
      "codex",
      "gemini-cli",
      "antigravity",
      "mcp-client"
    ],
    "installer": {
      "bash": "install.sh",
      "powershell": "install.ps1"
    }
  },
  "mcp_server": {
    "enabled": true,
    "entry": "mcp_server/server.py",
    "transport": "stdio",
    "tools_count": 24
  },
